PORT=3000
# Tùy chọn: tên miền chính. Mở trang bằng địa chỉ khác sẽ được chuyển hướng 301 về đây.
CANONICAL_HOST=
# Điền cả hai biến dưới đây để dùng Supabase thay cho kho cục bộ.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Tùy chọn: lưu ảnh và video trong thư mục Drive. Dùng OAuth cho Drive cá nhân,
# hoặc tài khoản dịch vụ cho Shared Drive. Xem README.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
